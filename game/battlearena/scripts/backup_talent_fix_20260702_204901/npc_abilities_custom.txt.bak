// File 'E:\projects\AngelArenaReborn\Repos\Angel Arena\configs\ability_override\angel_arena_agility_breaker.kv' begin 
"angel_arena_agility_breaker"
{
	"BaseClass"						"ability_datadriven"
	"AbilityBehavior"				"DOTA_ABILITY_BEHAVIOR_PASSIVE"
	"AbilityTextureName"			"custom/angel_arena_agility_breaker"

	"MaxLevel"				"7"
	"LevelsBetweenUpgrades"			"3"
	
	"AbilitySpecial"
	{
		"01"
		{
			"var_type"					"FIELD_INTEGER"
			"bonus_agi"					"2 3 4 5 6 7 8"
		}
		"02"
		{
			"var_type"					"FIELD_INTEGER"
			"tick_time"					"3"
		}
	}
	
	"OnUpgrade"
	{
		"RunScript"
		{
			"ScriptFile"		"heroes/pa/agility_breaker.lua"
			"Function"			"OnUpgrade"
			"ModifierName"		"modifier_angel_arena_agility_stack"
		}
	}
	
	"Modifiers"
	{
		"modifier_angel_arena_agility_passive"
		{
			"isBuff"	"1"
			"IsHidden"	"1"
			"Passive"	"1"
			"ThinkInterval"  "%tick_time"

			"OnIntervalThink"
			{
				"RunScript"
				{
					"ScriptFile"		"heroes/pa/agility_breaker.lua"
					"Function"			"OnIntervalThink"
					"ModifierName"		"modifier_angel_arena_agility_stack"
				}
			}
		}
		
		"modifier_angel_arena_agility_stack"
		{
			"isBuff"	"1"
			"IsHidden"	"0"
			"Passive"	"0"
			"Attributes" 		        "MODIFIER_ATTRIBUTE_PERMANENT"
			
			"Properties"
			{
				"MODIFIER_PROPERTY_STATS_AGILITY_BONUS"		"%bonus_agi"
			}
		}
	}	
}

// File 'E:\projects\AngelArenaReborn\Repos\Angel Arena\configs\ability_override\angel_arena_agility_breaker.kv' end

// File 'E:\projects\AngelArenaReborn\Repos\Angel Arena\configs\ability_override\angel_arena_fast_aura.kv' begin 
"angel_arena_fast_aura"
{
	// General
	//-------------------------------------------------------------------------------------------------------------
	"BaseClass"						"ability_datadriven"
	"AbilityBehavior"				"DOTA_ABILITY_BEHAVIOR_PASSIVE | DOTA_ABILITY_BEHAVIOR_AURA"
	"AbilityUnitTargetTeam"			"DOTA_UNIT_TARGET_TEAM_FRIENDLY"
	"AbilityTextureName"			"custom/angel_arena_fast_aura"
	
	"AbilityCooldown"				"3.0"
	
	// Time		
	//-------------------------------------------------------------------------------------------------------------
	"MaxLevel"						"7"
	// Special
	//-------------------------------------------------------------------------------------------------------------
	"AbilitySpecial"
	{
		"01"
		{
			"var_type"				"FIELD_INTEGER"
			"aura_radius"			"900 900 900 900 900 900 900"
		}
		"02"
		{
			"var_type"				"FIELD_INTEGER"
			"bonus_aspeed"			"10 15 20 25 30 40 45"
		}
		"03"
		{
			"var_type"				"FIELD_INTEGER"
			"bonus_speed"			"5 6 7 8 9 10 12"
		}
		"04"
		{
			"var_type"				"FIELD_FLOAT"
			"duration"				"1.0"
		}
		"05"
		{
			"var_type"				"FIELD_FLOAT"
			"duration_creep"		"2.0"
		}
		"06"
		{
			"var_type"				"FIELD_INTEGER"
			"chance_pct"			"5 8 10 12 14 18 22"
		}
		"07"
		{
			"var_type"				"FIELD_INTEGER"
			"bonus_damage"			"40 50 60 70 90 120 160"
		}
	}
	
	"Modifiers"
	{
		"modifier_fast_aura"
		{
			"Passive"			"1"
			"IsHidden"			"0"

			"Properties"
			{
				"MODIFIER_PROPERTY_ATTACKSPEED_BONUS_CONSTANT"	"%bonus_aspeed"
				"MODIFIER_PROPERTY_MOVESPEED_BONUS_PERCENTAGE" 	"%bonus_speed"
			}
		}
		
		"modifier_fast_aura_emitter"  
		{
			"Passive"				"1"
			"IsHidden"				"1"
			
			"Aura" 					"modifier_fast_aura"
			"Aura_Radius" 			"%aura_radius"
			"Aura_Teams" 			"DOTA_UNIT_TARGET_TEAM_FRIENDLY"
			"Aura_Types" 			"DOTA_UNIT_TARGET_HERO | DOTA_UNIT_TARGET_BASIC"
			"Aura_ApplyToCaster" 	"1"
		}
		
		"modifier_fast_aura_basher"
		{
			"Passive"	"1"
			"IsHidden"	"1"
			"AllowsIllusionDuplicate"	"0"
			
			"OnCreated"
            {
				"RunScript"
				{
					"ScriptFile"		"heroes/nightshade/fast_aura_bash.lua"
					"Function"			"CheckIllusion"
				}
			}
			
			"OnAttackLanded"
			{
				"Random"
				{
					"Chance"	"%chance_pct"
					"PseudoRandom"	"DOTA_PSEUDO_RANDOM_FACELESS_BASH"

					"OnSuccess"
					{
						"FireSound"
						{
							"EffectName"	"Hero_FacelessVoid.TimeLockImpact"
							"Target"		"TARGET"
						}
						
						"RunScript"
						{
							"ScriptFile"		"heroes/nightshade/fast_aura_bash.lua"
							"Function"			"ApplyBash"
							"ModifierName"		"modifier_fast_aura_bash"
							"duration"			"%duration"
							"duration_creep"	"%duration_creep"
						}
				
						"Damage"
						{
							"Target"	"TARGET"
							"Type"		"DAMAGE_TYPE_MAGICAL"
							"Damage"	"%bonus_damage"
						}
					}
				}
			}
		}
		
		"modifier_fast_aura_bash"
		{
			"IsDebuff"	"1"
		
			"EffectName"	"particles/generic_gameplay/generic_stunned.vpcf"
			"EffectAttachType"	"follow_overhead"

			"StatusEffectName"		"particles/status_fx/status_effect_faceless_chronosphere.vpcf"
			"StatusEffectPriority"	"1"

			"States"
			{
				"MODIFIER_STATE_STUNNED"	"MODIFIER_STATE_VALUE_ENABLED"
				"MODIFIER_STATE_FROZEN"		"MODIFIER_STATE_VALUE_ENABLED"
			}
		}
	}
}
// File 'E:\projects\AngelArenaReborn\Repos\Angel Arena\configs\ability_override\angel_arena_fast_aura.kv' end

